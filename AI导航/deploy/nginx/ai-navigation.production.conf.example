# ad996.com 生产：HTTP(ACME+301) + HTTPS
# 证书：/etc/letsencrypt/live/ad996.com/{fullchain,privkey}.pem
#
# 双上游：8001 = admin_api（点击/热榜）；8096 = api_server（页面 + icon-proxy + health）

server {
    listen 80;
    listen [::]:80;
    server_name ad996.com www.ad996.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ad996.com www.ad996.com;

    ssl_certificate     /etc/letsencrypt/live/ad996.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ad996.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    client_max_body_size 25m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/click {
        proxy_pass http://127.0.0.1:8001;
    }
    location /api/hot-tools {
        proxy_pass http://127.0.0.1:8001;
    }
    location /api/hot-categories {
        proxy_pass http://127.0.0.1:8001;
    }
    location / {
        proxy_pass http://127.0.0.1:8096;
    }
}
